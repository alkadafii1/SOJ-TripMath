{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/"
    },
    {
      "src": "/storage/build/(.*)",
      "dest": "/public/storage/build/"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/"
    },
    {
      "src": "/vendors/(.*)",
      "dest": "/public/vendors/"
    },
    {
      "src": "/(.*\\.js$)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.css$)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "vite build",
  "outputDirectory": "public"
}